{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "ESNext"],

        "module": "ESNext",
        "moduleResolution": "bundler",

        "jsx": "react-jsx",

        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,

        "resolveJsonModule": true,
        "isolatedModules": true,

        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        }
    },
    "include": ["resources/js/**/*"],
    "exclude": ["node_modules", "public"]
}
